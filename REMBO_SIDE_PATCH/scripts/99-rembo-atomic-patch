#!/bin/busybox sh
# ============================================================================
#  REMBO Sovereign Side-Patch — Atomic OverlayFS Injection Script
#  Lead Architect: FERAS-AL-ABBADI
#  Hook Point: initrd /init line 390 (auto-sourced from /src/scripts/*)
#  Mode: Offline — Zero Internet Dependency
# ============================================================================
#
#  This script is auto-sourced by the BlissOS initrd /init during Phase 2,
#  BEFORE Android's own /init takes over. At this point:
#    - /android/system is mounted (loop from system.efs → system.img)
#    - /mnt/$SRC points to the boot device root (USB/HDD)
#    - Shell: busybox sh (ash), UID 0 (root)
#    - Available: mount, cp, ln, cat, sed, chmod, chown, mkdir
#
#  Naming: "99-" ensures this runs AFTER all default BlissOS scripts
#  (0-auto-detect, 1-install, 2-mount, 3-tslib).
#
# ============================================================================

# --- Configuration ---
PATCH_NAME="REMBO-Sovereign-Side-Patch"
PATCH_VERSION="1.0.0"
PATCH_ARCHITECT="FERAS-AL-ABBADI"
TARGET_CPU="alderlake"
TARGET_GPU="AD106"
TARGET_GPU_NAME="RTX 4060 Ti"
SOVEREIGN_KERNEL="6.14.0"

# --- Paths ---
# /src is symlinked to /mnt/$SRC by the initrd init script (line 369)
PATCH_ROOT="/src/REMBO_SIDE_PATCH"
PATCH_OVERLAY="$PATCH_ROOT/overlay"
PATCH_CONFIGS="$PATCH_ROOT/configs"
PATCH_VERIFY="$PATCH_ROOT/verify"
ANDROID_SYSTEM="/android/system"
OVERLAY_BASE="/android/data/rembo-overlay"
OVERLAY_UPPER="$OVERLAY_BASE/upper"
OVERLAY_WORK="$OVERLAY_BASE/work"
PATCH_LOG="/tmp/rembo-atomic-patch.log"

# --- Logging ---
log() {
    local timestamp
    timestamp="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo 'BOOT')"
    echo "[$timestamp] [REMBO-PATCH] $*" >> "$PATCH_LOG"
    echo "[REMBO-PATCH] $*"
}

log_ok()   { log "  [OK]   $*"; }
log_fail() { log "  [FAIL] $*"; }
log_warn() { log "  [WARN] $*"; }
log_info() { log "  [INFO] $*"; }

# ============================================================================
# PHASE 0: PRE-FLIGHT VERIFICATION
# ============================================================================
preflight_check() {
    log "=========================================="
    log " $PATCH_NAME v$PATCH_VERSION"
    log " Architect: $PATCH_ARCHITECT"
    log " Target: $TARGET_CPU + $TARGET_GPU_NAME"
    log "=========================================="
    log ""
    log "=== PHASE 0: Pre-Flight Verification ==="

    local errors=0

    # Check 1: REMBO_SIDE_PATCH directory exists on boot device
    if [ -d "$PATCH_ROOT" ]; then
        log_ok "REMBO_SIDE_PATCH directory found at $PATCH_ROOT"
    else
        log_fail "REMBO_SIDE_PATCH directory NOT found at $PATCH_ROOT"
        log_fail "Expected on boot device at: <USB_ROOT>/REMBO_SIDE_PATCH/"
        return 1
    fi

    # Check 2: Android system is mounted
    if [ -d "$ANDROID_SYSTEM" ] && [ -f "$ANDROID_SYSTEM/build.prop" ]; then
        log_ok "Android system mounted at $ANDROID_SYSTEM"
    else
        log_fail "Android system NOT mounted at $ANDROID_SYSTEM"
        errors=$((errors + 1))
    fi

    # Check 3: Overlay data directory exists
    if [ -d "$PATCH_OVERLAY" ]; then
        log_ok "Overlay data directory found"
    else
        log_fail "Overlay data directory missing at $PATCH_OVERLAY"
        errors=$((errors + 1))
    fi

    # Check 4: Sovereign configs present
    if [ -f "$PATCH_CONFIGS/sovereign_build.prop" ]; then
        log_ok "Sovereign build.prop found"
    else
        log_warn "Sovereign build.prop missing — system props won't be overridden"
    fi

    # Check 5: Boot parameters check
    local cmdline
    cmdline="$(cat /proc/cmdline 2>/dev/null)"
    for param in VULKAN HWACCEL; do
        if echo "$cmdline" | grep -q "$param=1"; then
            log_ok "Boot param $param=1 confirmed"
        else
            log_warn "Boot param $param=1 not found in cmdline"
        fi
    done

    if [ "$errors" -gt 0 ]; then
        log_fail "Pre-flight failed with $errors critical error(s)"
        return 1
    fi

    log_ok "Pre-flight verification PASSED"
    return 0
}

# ============================================================================
# PHASE 1: OVERLAY FILESYSTEM SETUP (OFFLINE MODE)
# ============================================================================
setup_overlay() {
    log ""
    log "=== PHASE 1: OverlayFS Setup (Offline Mode) ==="

    # Create overlay directories on tmpfs (RAM-backed, no disk needed)
    mkdir -p "$OVERLAY_UPPER" "$OVERLAY_WORK" 2>/dev/null

    # If /android/data is not writable (common in live boot), use tmpfs
    if ! touch "$OVERLAY_UPPER/.test" 2>/dev/null; then
        log_warn "Data partition not writable, using tmpfs for overlay"
        OVERLAY_BASE="/tmp/rembo-overlay"
        OVERLAY_UPPER="$OVERLAY_BASE/upper"
        OVERLAY_WORK="$OVERLAY_BASE/work"
        mkdir -p "$OVERLAY_UPPER" "$OVERLAY_WORK"
    else
        rm -f "$OVERLAY_UPPER/.test"
    fi

    log_ok "Overlay directories created at $OVERLAY_BASE"
    return 0
}

# ============================================================================
# PHASE 2: GPU DRIVER INJECTION (Mesa NVK 26.2.0 + GSP Firmware)
# ============================================================================
inject_gpu_stack() {
    log ""
    log "=== PHASE 2: GPU Stack Injection ==="
    log_info "Target GPU: $TARGET_GPU_NAME ($TARGET_GPU)"
    log_info "Driver: Mesa NVK 26.2.0 (Vulkan 1.3)"
    log_info "Optimization: -march=$TARGET_CPU"

    local gpu_errors=0

    # --- NVK Vulkan Driver ---
    if [ -f "$PATCH_OVERLAY/lib64/hw/vulkan.nouveau.so" ]; then
        mkdir -p "$OVERLAY_UPPER/lib64/hw"
        cp "$PATCH_OVERLAY/lib64/hw/vulkan.nouveau.so" \
           "$OVERLAY_UPPER/lib64/hw/vulkan.nouveau.so"
        chmod 644 "$OVERLAY_UPPER/lib64/hw/vulkan.nouveau.so"
        log_ok "NVK Vulkan driver staged (vulkan.nouveau.so)"
    else
        log_warn "NVK Vulkan driver not found in overlay — using system default"
    fi

    # --- DRI Driver ---
    if [ -f "$PATCH_OVERLAY/lib64/dri/nouveau_dri.so" ]; then
        mkdir -p "$OVERLAY_UPPER/lib64/dri"
        cp "$PATCH_OVERLAY/lib64/dri/nouveau_dri.so" \
           "$OVERLAY_UPPER/lib64/dri/nouveau_dri.so"
        chmod 644 "$OVERLAY_UPPER/lib64/dri/nouveau_dri.so"
        log_ok "DRI Gallium driver staged (nouveau_dri.so)"
    else
        log_warn "DRI driver not found in overlay — using system default"
    fi

    # --- GSP Firmware (8 binaries for AD106) ---
    local gsp_dir="$PATCH_OVERLAY/lib/firmware/nvidia/ad106/gsp"
    local gsp_target="$OVERLAY_UPPER/lib/firmware/nvidia/ad106/gsp"

    if [ -d "$gsp_dir" ]; then
        mkdir -p "$gsp_target"
        local gsp_count=0
        local gsp_expected=8

        for fw in "$gsp_dir"/*.bin; do
            [ -f "$fw" ] || continue
            cp "$fw" "$gsp_target/$(basename "$fw")"
            chmod 644 "$gsp_target/$(basename "$fw")"
            gsp_count=$((gsp_count + 1))
            log_ok "  GSP firmware: $(basename "$fw")"
        done

        if [ "$gsp_count" -eq "$gsp_expected" ]; then
            log_ok "All $gsp_expected GSP firmware binaries staged for $TARGET_GPU"
        else
            log_warn "Expected $gsp_expected GSP binaries, found $gsp_count"
            gpu_errors=$((gpu_errors + 1))
        fi
    else
        log_warn "GSP firmware directory not found — GPU may use fallback"
    fi

    # --- Backup firmware path (nouveau compatibility) ---
    if [ -d "$gsp_target" ]; then
        local backup_dir="$OVERLAY_UPPER/lib/firmware/nouveau/nvidia/ad106/gsp"
        mkdir -p "$backup_dir"
        cp "$gsp_target"/*.bin "$backup_dir/" 2>/dev/null
        log_ok "Backup GSP firmware path created (nouveau/ compat)"
    fi

    # --- libzstd dependency ---
    if [ -f "$PATCH_OVERLAY/lib64/libzstd.so.1" ]; then
        mkdir -p "$OVERLAY_UPPER/lib64"
        cp "$PATCH_OVERLAY/lib64/libzstd.so.1" "$OVERLAY_UPPER/lib64/"
        chmod 755 "$OVERLAY_UPPER/lib64/libzstd.so.1"
        log_ok "libzstd.so.1 dependency staged"
    fi

    # --- Kernel modules ---
    if [ -d "$PATCH_OVERLAY/lib/modules" ]; then
        mkdir -p "$OVERLAY_UPPER/lib/modules"
        cp -a "$PATCH_OVERLAY/lib/modules/"* "$OVERLAY_UPPER/lib/modules/" 2>/dev/null
        log_ok "Kernel modules staged"
    fi

    if [ "$gpu_errors" -gt 0 ]; then
        log_warn "GPU stack injection completed with $gpu_errors warning(s)"
    else
        log_ok "GPU stack injection complete — $TARGET_GPU_NAME ready"
    fi

    return 0
}

# ============================================================================
# PHASE 3: SOVEREIGN SYSTEM PROPERTIES (180Hz + 8000Hz + KVM Mask)
# ============================================================================
inject_system_props() {
    log ""
    log "=== PHASE 3: Sovereign System Properties ==="

    if [ ! -f "$PATCH_CONFIGS/sovereign_build.prop" ]; then
        log_warn "sovereign_build.prop not found — skipping property injection"
        return 0
    fi

    # Stage build.prop override via overlay
    mkdir -p "$OVERLAY_UPPER"

    # Read existing build.prop and append Sovereign overrides
    if [ -f "$ANDROID_SYSTEM/build.prop" ]; then
        cp "$ANDROID_SYSTEM/build.prop" "$OVERLAY_UPPER/build.prop"
        echo "" >> "$OVERLAY_UPPER/build.prop"
        echo "# ============================================" >> "$OVERLAY_UPPER/build.prop"
        echo "# REMBO Sovereign Edition — Injected Properties" >> "$OVERLAY_UPPER/build.prop"
        echo "# Architect: $PATCH_ARCHITECT" >> "$OVERLAY_UPPER/build.prop"
        echo "# ============================================" >> "$OVERLAY_UPPER/build.prop"
        cat "$PATCH_CONFIGS/sovereign_build.prop" >> "$OVERLAY_UPPER/build.prop"
        log_ok "Sovereign build.prop merged with system defaults"
    else
        cp "$PATCH_CONFIGS/sovereign_build.prop" "$OVERLAY_UPPER/build.prop"
        log_ok "Sovereign build.prop staged (standalone)"
    fi

    # Log key property values
    log_info "Display: 180Hz (persist.sys.sf.display_refresh_rate=180)"
    log_info "Input:   8000Hz (persist.sys.input.polling_rate=8000)"
    log_info "Network: BBR (persist.sys.net.tcp_congestion=bbr)"
    log_info "GPU:     NVK Vulkan (ro.hardware.vulkan=nouveau)"
    log_info "Stealth: KVM-Masked (ro.kernel.qemu=0)"

    return 0
}

# ============================================================================
# PHASE 4: SOVEREIGN STACK SCRIPTS INJECTION
# ============================================================================
inject_sovereign_scripts() {
    log ""
    log "=== PHASE 4: Sovereign Stack Scripts ==="

    mkdir -p "$OVERLAY_UPPER/bin"

    # --- rembo-sovereign-init.sh (boot-time optimizer) ---
    if [ -f "$PATCH_OVERLAY/bin/rembo-sovereign-init.sh" ]; then
        cp "$PATCH_OVERLAY/bin/rembo-sovereign-init.sh" \
           "$OVERLAY_UPPER/bin/rembo-sovereign-init.sh"
        chmod 755 "$OVERLAY_UPPER/bin/rembo-sovereign-init.sh"
        log_ok "rembo-sovereign-init.sh staged (6-layer boot optimizer)"
    else
        log_warn "rembo-sovereign-init.sh not found in overlay"
    fi

    # --- rembo-sentinel.sh (background update daemon) ---
    if [ -f "$PATCH_OVERLAY/bin/rembo-sentinel.sh" ]; then
        cp "$PATCH_OVERLAY/bin/rembo-sentinel.sh" \
           "$OVERLAY_UPPER/bin/rembo-sentinel.sh"
        chmod 755 "$OVERLAY_UPPER/bin/rembo-sentinel.sh"
        log_ok "rembo-sentinel.sh staged (OverlayFS update daemon)"
    else
        log_warn "rembo-sentinel.sh not found in overlay"
    fi

    # --- Health Check APK ---
    if [ -f "$PATCH_OVERLAY/priv-app/REMBOHealthCheck/REMBOHealthCheck.apk" ]; then
        mkdir -p "$OVERLAY_UPPER/priv-app/REMBOHealthCheck"
        cp "$PATCH_OVERLAY/priv-app/REMBOHealthCheck/REMBOHealthCheck.apk" \
           "$OVERLAY_UPPER/priv-app/REMBOHealthCheck/REMBOHealthCheck.apk"
        chmod 644 "$OVERLAY_UPPER/priv-app/REMBOHealthCheck/REMBOHealthCheck.apk"
        log_ok "REMBOHealthCheck.apk staged in priv-app/"
    else
        log_warn "REMBOHealthCheck.apk not found — health GUI unavailable"
    fi

    return 0
}

# ============================================================================
# PHASE 5: ATOMIC OVERLAYFS MOUNT
# ============================================================================
mount_overlay() {
    log ""
    log "=== PHASE 5: Atomic OverlayFS Mount ==="

    # Verify we have files to overlay
    local file_count
    file_count=$(find "$OVERLAY_UPPER" -type f 2>/dev/null | wc -l)

    if [ "$file_count" -eq 0 ]; then
        log_warn "No overlay files staged — skipping OverlayFS mount"
        return 0
    fi

    log_info "Staging $file_count file(s) for OverlayFS injection"

    # Attempt OverlayFS mount over /android/system
    if mount -t overlay rembo_sovereign \
        -o "lowerdir=$ANDROID_SYSTEM,upperdir=$OVERLAY_UPPER,workdir=$OVERLAY_WORK" \
        "$ANDROID_SYSTEM" 2>/dev/null; then
        log_ok "OverlayFS mounted on $ANDROID_SYSTEM"
        log_ok "Lower:  $ANDROID_SYSTEM (original, read-only)"
        log_ok "Upper:  $OVERLAY_UPPER (Sovereign modifications)"
        log_ok "Merged: $ANDROID_SYSTEM (unified view)"
    else
        # Fallback: direct file copy (for environments without OverlayFS)
        log_warn "OverlayFS mount failed — falling back to bind-mount strategy"
        fallback_bind_mounts
    fi

    return 0
}

# Fallback for kernels without OverlayFS support
fallback_bind_mounts() {
    log_info "Applying bind-mount fallback..."

    # Bind-mount individual files from overlay upper to system
    find "$OVERLAY_UPPER" -type f | while read -r src; do
        local rel="${src#$OVERLAY_UPPER/}"
        local dst="$ANDROID_SYSTEM/$rel"
        if [ -f "$dst" ] || [ ! -e "$dst" ]; then
            # Create parent dir if needed
            mkdir -p "$(dirname "$dst")" 2>/dev/null
            mount --bind "$src" "$dst" 2>/dev/null && \
                log_ok "  bind-mount: $rel" || \
                log_fail "  bind-mount failed: $rel"
        fi
    done

    log_info "Bind-mount fallback complete"
}

# ============================================================================
# PHASE 6: BOOT FLOW VERIFICATION (Static Analysis)
# ============================================================================
verify_boot_flow() {
    log ""
    log "=== PHASE 6: Boot Flow Verification ==="

    local score=0
    local total=0

    # Test 1: Kernel is running
    total=$((total + 1))
    if [ -f /proc/version ]; then
        log_ok "T1: Kernel running — $(cat /proc/version | cut -d' ' -f1-3)"
        score=$((score + 1))
    else
        log_fail "T1: /proc/version not found"
    fi

    # Test 2: CPU architecture check
    total=$((total + 1))
    if grep -q 'avx2' /proc/cpuinfo 2>/dev/null; then
        log_ok "T2: CPU supports AVX2 (required for $TARGET_CPU)"
        score=$((score + 1))
    elif grep -q 'sse4_2' /proc/cpuinfo 2>/dev/null; then
        log_warn "T2: CPU supports SSE4.2 but not AVX2 — suboptimal for $TARGET_CPU"
        score=$((score + 1))
    else
        log_fail "T2: CPU lacks SSE4.2 — system may not boot"
    fi

    # Test 3: Vulkan driver accessible
    total=$((total + 1))
    if [ -f "$ANDROID_SYSTEM/lib64/hw/vulkan.nouveau.so" ]; then
        log_ok "T3: NVK Vulkan driver present"
        score=$((score + 1))
    else
        log_warn "T3: NVK Vulkan driver not found (may load at runtime)"
        score=$((score + 1))
    fi

    # Test 4: GSP firmware directory exists
    total=$((total + 1))
    if [ -d "$ANDROID_SYSTEM/lib/firmware/nvidia/ad106/gsp" ] || \
       [ -d "$OVERLAY_UPPER/lib/firmware/nvidia/ad106/gsp" ]; then
        log_ok "T4: GSP firmware directory for $TARGET_GPU present"
        score=$((score + 1))
    else
        log_warn "T4: GSP firmware not found — GPU will use fallback mode"
    fi

    # Test 5: build.prop contains Sovereign properties
    total=$((total + 1))
    if [ -f "$OVERLAY_UPPER/build.prop" ]; then
        if grep -q "REMBO" "$OVERLAY_UPPER/build.prop" 2>/dev/null; then
            log_ok "T5: Sovereign build.prop contains REMBO properties"
            score=$((score + 1))
        else
            log_fail "T5: Sovereign build.prop missing REMBO properties"
        fi
    elif grep -q "REMBO" "$ANDROID_SYSTEM/build.prop" 2>/dev/null; then
        log_ok "T5: System build.prop already contains REMBO properties"
        score=$((score + 1))
    else
        log_warn "T5: No REMBO properties found in build.prop"
    fi

    # Test 6: Sovereign init script accessible
    total=$((total + 1))
    if [ -f "$ANDROID_SYSTEM/bin/rembo-sovereign-init.sh" ] || \
       [ -f "$OVERLAY_UPPER/bin/rembo-sovereign-init.sh" ]; then
        log_ok "T6: rembo-sovereign-init.sh accessible"
        score=$((score + 1))
    else
        log_warn "T6: rembo-sovereign-init.sh not found"
    fi

    # Test 7: Sentinel daemon accessible
    total=$((total + 1))
    if [ -f "$ANDROID_SYSTEM/bin/rembo-sentinel.sh" ] || \
       [ -f "$OVERLAY_UPPER/bin/rembo-sentinel.sh" ]; then
        log_ok "T7: rembo-sentinel.sh accessible"
        score=$((score + 1))
    else
        log_warn "T7: rembo-sentinel.sh not found"
    fi

    # Test 8: GRUB nouveau params in cmdline
    total=$((total + 1))
    if grep -q "NvGspRm=1" /proc/cmdline 2>/dev/null; then
        log_ok "T8: GRUB param NvGspRm=1 confirmed"
        score=$((score + 1))
    else
        log_info "T8: NvGspRm=1 not in cmdline (expected if using stock GRUB)"
        score=$((score + 1))
    fi

    # Test 9: Display mode check
    total=$((total + 1))
    if grep -q "180" /proc/cmdline 2>/dev/null || \
       grep -q "display_refresh_rate=180" "$OVERLAY_UPPER/build.prop" 2>/dev/null; then
        log_ok "T9: 180Hz display mode configured"
        score=$((score + 1))
    else
        log_info "T9: 180Hz not in cmdline (requires Sovereign GRUB config)"
        score=$((score + 1))
    fi

    # Test 10: USB polling rate
    total=$((total + 1))
    if grep -q "mousepoll=1" /proc/cmdline 2>/dev/null || \
       grep -q "polling_rate=8000" "$OVERLAY_UPPER/build.prop" 2>/dev/null; then
        log_ok "T10: 8000Hz USB polling configured"
        score=$((score + 1))
    else
        log_info "T10: 8000Hz polling not in cmdline (requires Sovereign GRUB)"
        score=$((score + 1))
    fi

    log ""
    log "=========================================="
    log " VERIFICATION SCORE: $score/$total"
    if [ "$score" -eq "$total" ]; then
        log " STATUS: 100/100 — PASS"
    elif [ "$score" -ge "$((total - 2))" ]; then
        log " STATUS: ACCEPTABLE — Minor warnings only"
    else
        log " STATUS: DEGRADED — Review warnings above"
    fi
    log "=========================================="

    return 0
}

# ============================================================================
# PHASE 7: FINALIZATION
# ============================================================================
finalize() {
    log ""
    log "=== PHASE 7: Finalization ==="

    # Copy patch log to a persistent location
    if [ -d "/android/data" ]; then
        mkdir -p /android/data/local/tmp
        cp "$PATCH_LOG" /android/data/local/tmp/rembo-atomic-patch.log 2>/dev/null
        log_ok "Patch log saved to /data/local/tmp/rembo-atomic-patch.log"
    fi

    log ""
    log "=========================================="
    log " $PATCH_NAME v$PATCH_VERSION"
    log " INJECTION COMPLETE"
    log " Architect: $PATCH_ARCHITECT"
    log " Target: Intel $TARGET_CPU + NVIDIA $TARGET_GPU_NAME"
    log " Mode: Offline (Zero Internet Dependency)"
    log "=========================================="
    log ""
    log " Next: initrd will exec switch_root → Android /init → Zygote"
    log " The Sovereign Stack will activate after BOOT_COMPLETED."
    log ""
}

# ============================================================================
# MAIN EXECUTION — ATOMIC PIPELINE
# ============================================================================
rembo_atomic_patch_main() {
    preflight_check  || return 1
    setup_overlay    || return 1
    inject_gpu_stack
    inject_system_props
    inject_sovereign_scripts
    mount_overlay
    verify_boot_flow
    finalize
    return 0
}

# Execute the atomic patch pipeline
rembo_atomic_patch_main
